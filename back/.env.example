# ============================================================
# Configuração de Banco de Dados MySQL
# Copie este arquivo para .env e preencha com suas credenciais
# ============================================================

# Credenciais MySQL
DB_NAME=lexabyte
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ============================================================
# Instruções
# ============================================================
# 1. Se você está usando XAMPP/MySQL local:
#    - Deixe DB_HOST=127.0.0.1 e DB_PORT=3306
#    - Deixe DB_PASSWORD vazio (padrão) ou configure sua senha
#
# 2. Se estiver usando MariaDB:
#    - Mesma configuração que MySQL
#
# 3. Depois de preencher, rode:
#    python manage.py migrate
#    python seed_mysql.py
